<! homotype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VR Gaming News</title>
    <style>
        body { background: #000; color: #00ffcc; font-family: sans-serif; padding: 10px; }
        h1 { font-size: 1.2rem; border-bottom: 2px solid #00ffcc; }
        .news-card { border: 1px solid #333; margin-bottom: 10px; padding: 8px; border-radius: 5px; }
        .title { font-weight: bold; color: #fff; font-size: 0.9rem; }
        .source { font-size: 0.7rem; color: #888; }
        button { background: #ff4e00; border: none; color: white; padding: 10px; width: 100%; border-radius: 5px; font-weight: bold; }
    </style>
</head>
<body>
    <h1>VR & AR Gaming</h1>
    <div id="news-container">Chargement des actus...</div>
    <button onclick="window.location.reload()">ACTUALISER</button>

    <script>
        // Simulation de flux (Remplacez par une API de news réelle si besoin)
        const news = [
            { t: "Nouveau casque VR en approche ?", s: "UploadVR" },
            { t: "Les lunettes AR pour le gaming mobile", s: "RoadToVR" },
            { t: "Mise à jour majeure pour le Quest 3", s: "The Verge" }
        ];
        
        const container = document.getElementById('news-container');
        container.innerHTML = news.map(n => `
            <div class="news-card">
                <div class="title">${n.t}</div>
                <div class="source">Source: ${n.s}</div>
            </div>
        `).join('');
    </script>
</body>
</html>
